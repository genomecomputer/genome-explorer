#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_dir="$repo_dir/.genome-explorer/build-venv"

if [ ! -x "$runtime_dir/bin/python" ]; then
  python3 -m venv "$runtime_dir"
fi

if ! "$runtime_dir/bin/python" -c 'import duckdb, PyInstaller' >/dev/null 2>&1; then
  "$runtime_dir/bin/pip" install --only-binary=:all: \
    -r "$repo_dir/prototype/requirements.txt" \
    -r "$repo_dir/prototype/build-requirements.txt"
fi

cd "$repo_dir"

case "${1:-cli}" in
  app)
    exec "$runtime_dir/bin/python" -m PyInstaller \
      --noconfirm \
      --clean \
      --windowed \
      --name "Genome Explorer" \
      --osx-bundle-identifier org.genomecomputer.genome-explorer.prototype \
      --paths "$repo_dir" \
      --hidden-import uuid \
      prototype/entrypoint.py
    ;;
  cli)
    exec "$runtime_dir/bin/python" -m PyInstaller \
      --noconfirm \
      --clean \
      --onefile \
      --name genome-explorer \
      --paths "$repo_dir" \
      --hidden-import uuid \
      prototype/entrypoint.py
    ;;
  *)
    echo "usage: ./prototype/build [app|cli]" >&2
    exit 2
    ;;
esac
